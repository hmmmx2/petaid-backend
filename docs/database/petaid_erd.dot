      <TR><TD ALIGN="LEFT" BGCOLOR="#f7fafc"><FONT FACE="Helvetica" POINT-SIZE="9"><B>image_url</B>  <FONT COLOR="#718096">text NULL</FONT></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#edf2f7"><FONT FACE="Helvetica" POINT-SIZE="9"><B>sent_at / created_at / updated_at</B>  <FONT COLOR="#718096">timestamptz</FONT></FONT></TD></TR>
      </TABLE>>]
  }

  subgraph cluster_don {
    label="Donations" style=dashed color="#e53e3e" fontsize=10 fontname=Helvetica bgcolor=white

    donations [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#2d3748" ALIGN="CENTER"><FONT COLOR="white" FACE="Helvetica" POINT-SIZE="11"><B>donations</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#ebf8ff"><FONT FACE="Helvetica" POINT-SIZE="9"><B>[PK]</B> <B>id</B>  <FONT COLOR="#718096">uuid</FONT></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#fef9c3"><FONT FACE="Helvetica" POINT-SIZE="9"><B>[FK]</B> <B>pet_owner_id</B>  <FONT COLOR="#718096">uuid CASCADE</FONT></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#edf2f7"><FONT FACE="Helvetica" POINT-SIZE="9"><B>amount_cents</B>  <FONT COLOR="#718096">integer CHECK(&gt;0)</FONT></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#f7fafc"><FONT FACE="Helvetica" POINT-SIZE="9"><B>currency</B>  <FONT COLOR="#718096">varchar(3)</FONT></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#edf2f7"><FONT FACE="Helvetica" POINT-SIZE="9"><B>status</B>  <FONT COLOR="#718096">varchar(9) CHECK(pending|succeeded|failed)</FONT></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#f7fafc"><FONT FACE="Helvetica" POINT-SIZE="9"><B>recurring</B>  <FONT COLOR="#718096">boolean</FONT></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#edf2f7"><FONT FACE="Helvetica" POINT-SIZE="9"><B>created_at / updated_at</B>  <FONT COLOR="#718096">timestamptz</FONT></FONT></TD></TR>
      </TABLE>>]

    donation_records [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#2d3748" ALIGN="CENTER"><FONT COLOR="white" FACE="Helvetica" POINT-SIZE="11"><B>donation_records</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#ebf8ff"><FONT FACE="Helvetica" POINT-SIZE="9"><B>[PK]</B> <B>id</B>  <FONT COLOR="#718096">uuid</FONT></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#fef9c3"><FONT FACE="Helvetica" POINT-SIZE="9"><B>[FK]</B> <B>donation_id</B>  <FONT COLOR="#718096">uuid UNIQUE CASCADE</FONT></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#edf2f7"><FONT FACE="Helvetica" POINT-SIZE="9"><B>transaction_ref</B>  <FONT COLOR="#718096">varchar(120) UNIQUE</FONT></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#f7fafc"><FONT FACE="Helvetica" POINT-SIZE="9"><B>provider</B>  <FONT COLOR="#718096">varchar(40)</FONT></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#edf2f7"><FONT FACE="Helvetica" POINT-SIZE="9"><B>amount_cents / currency</B>  <FONT COLOR="#718096">integer / varchar(3)</FONT></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#f7fafc"><FONT FACE="Helvetica" POINT-SIZE="9"><B>final_status</B>  <FONT COLOR="#718096">varchar(20)</FONT></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#edf2f7"><FONT FACE="Helvetica" POINT-SIZE="9"><B>processed_at / created_at / updated_at</B>  <FONT COLOR="#718096">timestamptz</FONT></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#fffbeb"><FONT FACE="Helvetica" POINT-SIZE="8" COLOR="#92400e"><I>1:1 composition &lt;- donations (CASCADE)</I></FONT></TD></TR>
      </TABLE>>]
  }

  subgraph cluster_fb {
    label="Feedback" style=dashed color="#319795" fontsize=10 fontname=Helvetica bgcolor=white

    feedback [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#2d3748" ALIGN="CENTER"><FONT COLOR="white" FACE="Helvetica" POINT-SIZE="11"><B>feedback</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#ebf8ff"><FONT FACE="Helvetica" POINT-SIZE="9"><B>[PK]</B> <B>id</B>  <FONT COLOR="#718096">uuid</FONT></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#fef9c3"><FONT FACE="Helvetica" POINT-SIZE="9"><B>[FK]</B> <B>submitter_id</B>  <FONT COLOR="#718096">uuid CASCADE</FONT></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#fef9c3"><FONT FACE="Helvetica" POINT-SIZE="9"><B>[FK]</B> <B>resource_id</B>  <FONT COLOR="#718096">uuid 0..1 CASCADE NULL</FONT></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#edf2f7"><FONT FACE="Helvetica" POINT-SIZE="9"><B>flagged</B>  <FONT COLOR="#718096">boolean</FONT></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#f7fafc"><FONT FACE="Helvetica" POINT-SIZE="9"><B>created_at / updated_at</B>  <FONT COLOR="#718096">timestamptz</FONT></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#fffbeb"><FONT FACE="Helvetica" POINT-SIZE="8" COLOR="#92400e"><I>resource_id -&gt; resources (0..1, CASCADE) [NEW design]</I></FONT></TD></TR>
      </TABLE>>]

    feedback_entries [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#2d3748" ALIGN="CENTER"><FONT COLOR="white" FACE="Helvetica" POINT-SIZE="11"><B>feedback_entries</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#ebf8ff"><FONT FACE="Helvetica" POINT-SIZE="9"><B>[PK]</B> <B>id</B>  <FONT COLOR="#718096">uuid</FONT></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#fef9c3"><FONT FACE="Helvetica" POINT-SIZE="9"><B>[FK]</B> <B>feedback_id</B>  <FONT COLOR="#718096">uuid UNIQUE CASCADE</FONT></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#edf2f7"><FONT FACE="Helvetica" POINT-SIZE="9"><B>rating</B>  <FONT COLOR="#718096">integer CHECK(1..5)</FONT></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#f7fafc"><FONT FACE="Helvetica" POINT-SIZE="9"><B>comment</B>  <FONT COLOR="#718096">text</FONT></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#edf2f7"><FONT FACE="Helvetica" POINT-SIZE="9"><B>created_at / updated_at</B>  <FONT COLOR="#718096">timestamptz</FONT></FONT></TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#fffbeb"><FONT FACE="Helvetica" POINT-SIZE="8" COLOR="#92400e"><I>1:1 composition &lt;- feedback (CASCADE)</I></FONT></TD></TR>
      </TABLE>>]
  }

  // ── Relationship colour legend ─────────────────────────────────────────
  legend [shape=none margin=0 label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="3" CELLPADDING="4" BGCOLOR="white">
    <TR><TD COLSPAN="2" ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="10"><B>Foreign keys &mdash; ON DELETE</B></FONT></TD></TR>
    <TR><TD BGCOLOR="#2b6cb0">    </TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9">CASCADE  (owned data / 1:1 composition)</FONT></TD></TR>
    <TR><TD BGCOLOR="#dd6b20">    </TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9">SET NULL  (optional vet assignment)</FONT></TD></TR>
    <TR><TD BGCOLOR="#c53030">    </TD><TD ALIGN="LEFT"><FONT FACE="Helvetica" POINT-SIZE="9">RESTRICT  (reference data / author)</FONT></TD></TR>
    </TABLE>>]

  // ── Edges (colour = ON DELETE action; the FK column is shown in-table) ──
  edge [color="#2b6cb0" style=solid]   // CASCADE
  user_credentials        -> accounts
  pets                    -> accounts
  first_aid_resource_link -> first_aid_guidance
  first_aid_resource_link -> resources
  quizzes                 -> resources
  quiz_attempts           -> accounts
  quiz_attempts           -> quizzes
  inquiries               -> accounts
  chats                   -> accounts
  chat_messages           -> chats
  chat_messages           -> accounts
  donations               -> accounts
  donation_records        -> donations
  feedback                -> accounts
  feedback                -> resources
  feedback_entries        -> feedback

  edge [color="#dd6b20" style=dashed]   // SET NULL
  inquiries -> accounts
  chats     -> accounts

  edge [color="#c53030" style=dashed]   // RESTRICT
  pets               -> pet_types
  first_aid_guidance -> pet_types
  first_aid_guidance -> accounts
  resources          -> pet_types
  resources          -> accounts
}
